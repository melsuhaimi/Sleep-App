{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sleep-app.local/schemas/result.schema.json",
  "title": "Engineering Proposal",
  "description": "Strict externally authored proposal. CANDIDATE is only a proposal; controller-owned verification determines whether it becomes a verified candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "manifest_commit",
    "status",
    "summary",
    "assumptions",
    "unknowns",
    "files_to_modify",
    "verification_required",
    "edits"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "run_id": {
      "type": "string"
    },
    "manifest_commit": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "NEEDS_MORE_CONTEXT",
        "ARCHITECTURE_CONTRADICTION",
        "UNKNOWN_ENVIRONMENT",
        "BLOCKED"
      ]
    },
    "summary": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_to_modify": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  }
}
